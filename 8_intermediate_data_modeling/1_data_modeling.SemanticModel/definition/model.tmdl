model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-MX
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Business Establishment by Age","Summary Statistics for Manufacturing","Geography"]

annotation PBI_ProTooling = ["DevMode"]

ref table Year
ref table 'Business Establishment by Age'
ref table 'Summary Statistics for Manufacturing'
ref table Geography

ref cultureInfo en-US

