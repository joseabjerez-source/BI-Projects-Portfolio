model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Year","Geography","NAICS Code","Summary Statistics (computed column)","Summary Statistics (calculated column)"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table Year
ref table Geography
ref table 'NAICS Code'
ref table 'Summary Statistics (computed column)'
ref table 'Summary Statistics (calculated column)'

ref cultureInfo en-US

