model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["NAICS Code","Geography","Summary Statistics for Manufacturing","Summary Statistics Double NAICS"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table 'NAICS Code'
ref table Geography
ref table 'Summary Statistics for Manufacturing'
ref table 'Summary Statistics Double NAICS'

ref cultureInfo en-US

