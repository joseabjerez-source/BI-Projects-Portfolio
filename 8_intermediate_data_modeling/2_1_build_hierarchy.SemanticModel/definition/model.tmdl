model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Business Establishment by Age","Establishment Age Code","NAICS Code","Geography","Summary Statistics for Manufacturing","Establishments"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table 'Business Establishment by Age'
ref table 'Establishment Age Code'
ref table 'NAICS Code'
ref table Geography
ref table Year
ref table 'Summary Statistics for Manufacturing'
ref table Establishments

ref cultureInfo en-US

